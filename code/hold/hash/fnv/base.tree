
task fnv-hash-32-1a
  take v
  take seed
  save a
    call bitwise-xor
      mark 2166136261
      call or
        read seed
        mark 0
  save i, mark 0
  save n, read v/length
  walk test
    hook test
      call is-less-than
        read i
        read n
    hook true
      save c, call v/get, read i
      save d
        call bitwise-and
          read c
          mark 0xff00
      stem test
        call is-present
          read d
        hook true
          save a
            call fnv-hash-32-multiply
              call bitwise-xor
                read a
                call shift-right
                  read d
                  mark 8
      save a
        call fnv-hash-32-multiply
          call bitwise-xor
            read a
            call bitwise-and
              read c
              mark 0xff
      save i, call increment, read i
  back seed, call fnv-hash-32-mixer, read a

task fnv-hash-32-mixer
  take a
  save a
    call add
      bind a
      call shift-left
        read a
        mark 13
  save a
    call bitwise-xor
      bind a
      call unsigned-shift-right
        read a
        mark 7
  save a
    call add
      bind a
      call shift-left
        read a
        mark 3
  save a
    call bitwise-xor
      bind a
      call unsigned-shift-right
        read a
        mark 17
  save a
    call add
      bind a
      call shift-left
        read a
        mark 5
  back seed
    call bitwise-and
      read a
      mark 0xffffffff

task fnv-hash-32-multiply
  note <a * 16777619 mod 2**32.>
  take a
  back seed
    call add
      call add
        call add
          call add
            call add
              read a
              call shift-left
                read a
                mark 1
            call shift-left
              read a
              mark 4
          call shift-left
            read a
            mark 7
        call shift-left
          read a
          mark 8
      call shift-left
        read a
        mark 24
