
form report
  link passed, like size
  link failed, like size
  link skipped, like size
  link duration, like size

form failure
  link name, like text
  link message, like text
  link expected
  link actual

form mock-state
  link count, like size

task make-report
  take passed, like size
  take failed, like size
  take skipped, like size
  take duration, like size
  send back
    make report
      bind passed, read passed
      bind failed, read failed
      bind skipped, read skipped
      bind duration, read duration

task get-passed
  take r, like report
  fork case, read r
    case report, base passed, base failed, base skipped, base duration
      send back, read passed

task get-total
  take r, like report
  fork case, read r
    case report, base passed, base failed, base skipped, base duration
      send back
        call add
          bind a
            call add
              bind a, read passed
              bind b, read failed
          bind b, read skipped

task make-failure
  take name, like text
  take message, like text
  take expected
  take actual
  send back
    make failure
      bind name, read name
      bind message, read message
      bind expected, read expected
      bind actual, read actual

task make-mock
  send back
    make mock-state
      bind count, mark 0

task get-count
  take m, like mock-state
  fork case, read m
    case mock-state, base count
      send back, read count
