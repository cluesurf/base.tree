
load @cluesurf/base/code/process/current
  find process-info

task read
  like process-info

  send back
    make process-info
      bind id, read process/pid
      bind arguments, read process/argv
      bind directory
        call process/cwd
      bind executable, read process/exec-path

task exit
  take code, like size, fall 0

  call process/exit
    read code

task listen
  take signal, like text
  take handler, like task

  save signal-name
    fork roll
      hook test
        call is-equal
          bind a, read signal
          bind b, text <terminate>
        send back, text <SIGTERM>
      hook test
        call is-equal
          bind a, read signal
          bind b, text <interrupt>
        send back, text <SIGINT>
      hook test
        call is-equal
          bind a, read signal
          bind b, text <hangup>
        send back, text <SIGHUP>
      hook fall
        send back, read signal

  call process/on
    read signal-name
    read handler
