
dock load
  load <node:fs/promises>, name fs-promise

task make
  mark async
  take from, like text
  take to, like text
  take hard, like bool, fall wave false

  fork test, name hard
    hook true
      call fs-promise/link
        mark async
        read from
        read to
        halt kink
    hook false
      call fs-promise/symlink
        mark async
        read from
        read to
        halt kink

task read
  mark async
  take path, like text

  send back
    call fs-promise/readlink
      mark async
      read path
      halt kink
