
dock load
  load <node:fs/promises>, name fs-promise

task read
  mark async
  take path, like text

  save stats
    call fs-promise/stat
      mark async
      read path
      halt kink

  send back
    make file-owner
      bind user, read stats/uid
      bind group, read stats/gid

task write
  mark async
  take path, like text
  take user, like size
  take group, like size

  call fs-promise/chown
    mark async
    read path
    read user
    read group
    halt kink
