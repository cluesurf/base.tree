
task get
  like text

  send back
    call kotlin-current-dir

task set
  take path, like text

  call kotlin-set-current-dir
    read path

task kotlin-current-dir
  mark private
  dock call <System.getProperty("user.dir") ?: "">

task kotlin-set-current-dir
  mark private
  take path, like text
  dock call <System.setProperty("user.dir", path)>
