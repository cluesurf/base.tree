
task read
  save current
    call kotlin-locale-default
  save tag, read current/to-language-tag
  save language, read current/language
  save region, read current/country
  save timezone
    call kotlin-timezone-id
  send back
    make locale
      bind language, read language
      bind region, read region
      bind tag, read tag
      bind timezone, read timezone

task list
  send back
    call kotlin-available-locales

task kotlin-locale-default
  hide true
  dock call <java.util.Locale.getDefault()>

task kotlin-timezone-id
  hide true
  dock call <java.util.TimeZone.getDefault().id>

task kotlin-available-locales
  hide true
  dock call <java.util.Locale.getAvailableLocales().map { it.toLanguageTag() }>
