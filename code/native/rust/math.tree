note <rust math implementation. Forwards to the linked `math` runtime shim. Internal: reached only through the public math API.>

dock load
  load <global:math>, name math

task abs
  take value, like number
  like number
  send back
    call math/abs
      read value

task min
  take a, like number
  take b, like number
  like number
  send back
    call math/min
      read a
      read b

task max
  take a, like number
  take b, like number
  like number
  send back
    call math/max
      read a
      read b

task pow
  take base, like number
  take exponent, like number
  like number
  send back
    call math/pow
      read base
      read exponent

task signum
  take value, like number
  like number
  send back
    call math/sign
      read value

task sqrt
  take value, like number
  like number
  send back
    call math/sqrt
      read value

task floor
  take value, like number
  like number
  send back
    call math/floor
      read value

task ceil
  take value, like number
  like number
  send back
    call math/ceil
      read value

task round-nearest
  take value, like number
  like number
  send back
    call math/round
      read value
