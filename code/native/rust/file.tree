
dock load
  load <std:fs>, name fs
  load <std:path>, name path-mod

task read
  take path, like text
  take format, like text, fall text <text>

  fork test, call is-equal, read format, text <bytes>
    hook true
      send back
        call fs/read
          read path
          halt kink
    hook false
      send back
        call fs/read-to-string
          read path
          halt kink

task write
  take path, like text
  take data, like text

  call fs/write
    read path
    read data
    halt kink

task append
  take path, like text
  take data, like text

  save handle
    call fs/open-options/new
      call append, wave true
      call open, read path
      halt kink
  call handle/write-all
    read data
    halt kink

task copy
  take from, like text
  take to, like text
  take deep, like bool, fall wave false

  fork test, name deep
    hook true
      call copy-dir-recursive
        read from
        read to
    hook false
      call fs/copy
        read from
        read to
        halt kink

task move
  take from, like text
  take to, like text

  call fs/rename
    read from
    read to
    halt kink

task remove
  take path, like text
  take deep, like bool, fall wave false

  fork test, name deep
    hook true
      call fs/remove-dir-all
        read path
        halt kink
    hook false
      save meta
        call fs/metadata
          read path
          halt kink
      fork test, call meta/is-dir
        hook true
          call fs/remove-dir
            read path
            halt kink
        hook false
          call fs/remove-file
            read path
            halt kink

task test
  take path, like text
  take kind, like text, need false

  save exists-result
    call fs/metadata
      read path
  fork test
    hook test
      call exists-result/is-err
    hook hold
      send back, wave false

  fork test, call is-null, read kind
    hook true
      send back, wave true

  save meta
    call exists-result/unwrap

  fork test, call is-equal, read kind, text <file>
    hook true
      send back, call meta/is-file

  fork test, call is-equal, read kind, text <directory>
    hook true
      send back, call meta/is-dir

  fork test, call is-equal, read kind, text <link>
    hook true
      save link-meta
        call fs/symlink-metadata
          read path
          halt kink
      send back
        call link-meta/file-type
          save ft
        call ft/is-symlink

  send back, wave true

task make-directory
  take path, like text
  take deep, like bool, fall wave false

  fork test, name deep
    hook true
      call fs/create-dir-all
        read path
        halt kink
    hook false
      call fs/create-dir
        read path
        halt kink

task list-directory
  take path, like text

  save entries
    call fs/read-dir
      read path
      halt kink
  send back, read entries

task copy-dir-recursive
  take from, like text
  take to, like text

  call fs/create-dir-all
    read to
    halt kink

  save entries
    call fs/read-dir
      read from
      halt kink

  walk list, read entries
    hook next
      take site, name entry
      save entry-val
        call entry/unwrap
      save entry-path
        call entry-val/path
      save file-name
        call entry-path/file-name
          save name
        call name/to-str
          save name-str
      save dest
        call path-mod/path/new
          read to
        call dest/join
          read name-str
      save file-type
        call entry-val/file-type
          halt kink
      fork test, call file-type/is-dir
        hook true
          call copy-dir-recursive
            read entry-path
            read dest
        hook false
          call fs/copy
            read entry-path
            read dest
            halt kink
