
task read
  send back
    make info
      bind system, text <browser>
      bind architecture, text <wasm>
      bind name
        call browser-user-agent
      bind version, text <>
      bind endian, text <LE>
      bind cores
        call browser-cores
      bind memory
        call browser-memory

task browser-user-agent
  mark private
  dock call <navigator.userAgent>

task browser-cores
  mark private
  dock call <navigator.hardwareConcurrency || 1>

task browser-memory
  mark private
  dock call <(navigator.deviceMemory || 0) * 1073741824>
