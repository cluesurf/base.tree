
dock load
  load <Foundation>, name foundation

load @cluesurf/base/code/process
  find result
  find child

task run
  mark async
  take command, like text
  take arguments, like list, need false
  take directory, like text, need false
  take environment, like hash, need false
  take shell, like bool, fall false
  take timeout, like size, need false
  take input, like text, need false
  like result

  save proc, make foundation/process

  fork test, read shell
    hook true
      call proc/set-executable-url
        call foundation/url
          bind file-url-with-path, text </bin/sh>
      call proc/set-arguments
        make list
          text <-c>
          call concat
            bind a, read command
            bind b, text < >
            bind c
              call join
                bind list, read arguments
                bind separator, text < >
    hook false
      call proc/set-executable-url
        call foundation/url
          bind file-url-with-path, text </usr/bin/env>
      call proc/set-arguments
        call concat-lists
          make list
            read command
          read arguments

  fork test
    call is-some, bind value, read directory
    hook true
      call proc/set-current-directory-url
        call foundation/url
          bind file-url-with-path, read directory

  fork test
    call is-some, bind value, read environment
    hook true
      call proc/set-environment
        read environment

  save stdout-pipe, make foundation/pipe
  save stderr-pipe, make foundation/pipe
  call proc/set-standard-output, read stdout-pipe
  call proc/set-standard-error, read stderr-pipe

  fork test
    call is-some, bind value, read input
    hook true
      save stdin-pipe, make foundation/pipe
      call proc/set-standard-input, read stdin-pipe
      call stdin-pipe/file-handle-for-writing/write
        call input/data
          bind using, text <utf8>
      call stdin-pipe/file-handle-for-writing/close-file

  call proc/run
    halt kink
  call proc/wait-until-exit

  save stdout-data
    call stdout-pipe/file-handle-for-reading/read-data-to-end-of-file
  save stderr-data
    call stderr-pipe/file-handle-for-reading/read-data-to-end-of-file

  save code
    call proc/termination-status

  send back
    make result
      bind code, read code
      bind stdout
        call foundation/string
          bind data, read stdout-data
          bind encoding, text <utf8>
      bind stderr
        call foundation/string
          bind data, read stderr-data
          bind encoding, text <utf8>
      bind ok
        call is-equal
          bind a, read code
          bind b, mark 0

task spawn
  mark async
  take command, like text
  take arguments, like list, need false
  take directory, like text, need false
  take environment, like hash, need false
  take shell, like bool, fall false
  like child

  save proc, make foundation/process

  fork test, read shell
    hook true
      call proc/set-executable-url
        call foundation/url
          bind file-url-with-path, text </bin/sh>
      call proc/set-arguments
        make list
          text <-c>
          call concat
            bind a, read command
            bind b, text < >
            bind c
              call join
                bind list, read arguments
                bind separator, text < >
    hook false
      call proc/set-executable-url
        call foundation/url
          bind file-url-with-path, text </usr/bin/env>
      call proc/set-arguments
        call concat-lists
          make list
            read command
          read arguments

  fork test
    call is-some, bind value, read directory
    hook true
      call proc/set-current-directory-url
        call foundation/url
          bind file-url-with-path, read directory

  fork test
    call is-some, bind value, read environment
    hook true
      call proc/set-environment
        read environment

  save stdin-pipe, make foundation/pipe
  save stdout-pipe, make foundation/pipe
  save stderr-pipe, make foundation/pipe
  call proc/set-standard-input, read stdin-pipe
  call proc/set-standard-output, read stdout-pipe
  call proc/set-standard-error, read stderr-pipe

  call proc/run
    halt kink

  send back
    make child
      bind dock, read proc
      bind id
        call proc/process-identifier
