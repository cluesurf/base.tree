
form list
  head t

  task push
    take self, flex true
    take item, like t

  task pop
    take self, flex true

  task get
    take self
    take index, like u64

  task set
    take self, flex true
    take index, like u64
    take item, like t

  task get-size
    take self
    like u64

  task is-empty
    take self
    like boolean

  task map
    head s
    take self
    like list

  task filter
    take self
    like list

  task reduce
    take self

  task reverse
    take self
    like list

  task sort
    take self, flex true

  task concat
    take self
    take other, like list
    like list

  task has
    take self
    take item, like t
    like boolean

  task get-first
    take self

  task get-last
    take self

  task insert
    take self, flex true
    take index, like u64
    take item, like t

  task remove
    take self, flex true
    take index, like u64

  task join
    take self
    take separator, like text
    like text

  task slice
    take self
    take start, like u64
    take end, like u64
    like list
