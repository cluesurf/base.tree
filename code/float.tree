
host infinity, term infinity
host negative-infinity, term negative-infinity

tree float
  hook fuse
    task round-up
    task round-down
    task round
    task truncate-start
    task truncate-end
    task get-sign-as-number

    task square-root
    task compute-sine
    task compute-cosine
    task compute-tangent
    task compute-inverse-sine
    task compute-inverse-cosine
    task compute-inverse-tangent
    task compute-hyperbolic-sine
    task compute-hyperbolic-cosine
    task compute-hyperbolic-tangent
    task compute-inverse-hyperbolic-sine
    task compute-inverse-hyperbolic-cosine
    task compute-inverse-hyperbolic-tangent

task abs
  take v, like f64
  like f64

task acos
  take v, like f64
  like f64

task asin
  take v, like f64
  like f64

task atan
  take v, like f64
  like f64

task atan2
  take y, like f64
  take x, like f64
  like f64

task ceil
  take v, like f64
  like i32

task cos
  take v, like f64
  like f64

task exp
  take v, like f64
  like f64

task fceil
  take v, like f64
  like f64

task ffloor
  take v, like f64
  like f64

task floor
  take v, like f64
  like i32

task fround
  take v, like f64
  like f64

task is-finite
  take f, like f64
  like bool

task is-nan
  take f, like f64
  like bool

task log
  take v, like f64
  like f64

task max
  take a, like f64
  take b, like f64
  like f64

task min
  take a, like f64
  take b, like f64
  like f64

task pow
  take v, like f64
  take exp, like f64
  like f64

task random
  like f64

task round
  take v, like f64
  like i32

task sin
  take v, like f64
  like f64

task sqrt
  take v, like f64
  like f64

task tan
  take v, like f64
  like f64
