note <The JSON value: a dynamic, recursive sum over the six JSON shapes. parse produces it; the leaf accessors read it. Pure, no platform dependency.>

form json-value
  case json-null
  case json-boolean
    link value, like boolean
  case json-number
    link value, like number
  case json-text
    link value, like text
  case json-array
    link items, like list
  case json-object
    link entries, like hash

task as-number
  take self, like json-value
  like number
  fork case, read self
    case json-number
      send back, read self/value
    case json-null
      send back, mark 0
    case json-boolean
      send back, mark 0
    case json-text
      send back, mark 0
    case json-array
      send back, mark 0
    case json-object
      send back, mark 0

task as-text
  take self, like json-value
  like text
  fork case, read self
    case json-text
      send back, read self/value
    case json-null
      send back, text <>
    case json-boolean
      send back, text <>
    case json-number
      send back, text <>
    case json-array
      send back, text <>
    case json-object
      send back, text <>

task as-boolean
  take self, like json-value
  like boolean
  fork case, read self
    case json-boolean
      send back, read self/value
    case json-null
      send back, wave false
    case json-number
      send back, wave false
    case json-text
      send back, wave false
    case json-array
      send back, wave false
    case json-object
      send back, wave false

task is-null
  take self, like json-value
  like boolean
  fork case, read self
    case json-null
      send back, wave true
    case json-boolean
      send back, wave false
    case json-number
      send back, wave false
    case json-text
      send back, wave false
    case json-array
      send back, wave false
    case json-object
      send back, wave false
