note <JSON. The clean uniform interface; parse / stringify are native-delegated to the host JSON, hidden behind the API. The json-value type and its leaf accessors live in json/value.>

load @cluesurf/base/code/native/json
  find do-parse
  find do-stringify
  find do-stringify-value
  find do-get-field
  find do-get-item

load @cluesurf/base/code/json/value
  find json-value

task parse
  take text, like text
  like json-value
  send back
    call do-parse
      read text

task stringify
  head t
  take value, like t
  like text
  send back
    call do-stringify
      read value

task stringify-value
  take value, like json-value
  like text
  send back
    call do-stringify-value
      read value

task get-field
  take self, like json-value
  take key, like text
  like json-value
  send back
    call do-get-field
      read self
      read key

task get-item
  take self, like json-value
  take index, like number
  like json-value
  send back
    call do-get-item
      read self
      read index
