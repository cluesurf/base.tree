
note <Text (string) operations.>

task char-at
  take value, like text
  take index, like integer
  like text

task char-code-at
  take value, like text
  take index, like integer
  like integer

task index-of
  take value, like text
  take search, like text
  take start-index, like integer, need false
  like integer

task last-index-of
  take value, like text
  take search, like text
  take start-index, like integer, need false
  like integer

task split
  take value, like text
  take delimiter, like text
  like list

task substring
  take value, like text
  take start-index, like integer
  take end-index, like integer, need false
  like text

task to-lower-case
  take value, like text
  like text

task to-upper-case
  take value, like text
  like text

task starts-with
  take value, like text
  take prefix, like text
  like boolean

task ends-with
  take value, like text
  take suffix, like text
  like boolean

task trim
  take value, like text
  like text

task trim-start
  take value, like text
  like text

task trim-end
  take value, like text
  like text

task pad-left
  take value, like text
  take length, like integer
  take fill, like text
  like text

task pad-right
  take value, like text
  take length, like integer
  take fill, like text
  like text

task replace
  take value, like text
  take search, like text
  take replacement, like text
  like text

task replace-all
  take value, like text
  take search, like text
  take replacement, like text
  like text

task contains
  take value, like text
  take search, like text
  like boolean

note <Character encodings.>

form encoding
  case ascii
  case base-64
  case hex
  case latin-1
  case utf-8
  case utf-16
  case utf-16-be
  case utf-16-le
  case utf-32
