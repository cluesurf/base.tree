
form server
  link dock, hide true
  link host, like text
  link port, like size

task start
  wait true
  take port, like size
  take host, like text, fall text <0.0.0.0>
  take handler, like task
  take secure, like bool, fall false
  take certificate, like text, need false
  take key, like text, need false
  like server

task stop
  wait true
  take server, like server
