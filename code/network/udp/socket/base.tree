
load @cluesurf/base/code/network/udp
  find socket

form datagram
  link data, like text
  link host, like text
  link port, like size

task send
  wait true
  take socket, like socket
  take data, like text
  take host, like text
  take port, like size
  like size

task receive
  wait true
  take socket, like socket
  like datagram

task stream
  wait true
  take socket, like socket
  like list

task close
  wait true
  take socket, like socket
