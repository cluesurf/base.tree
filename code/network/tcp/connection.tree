
load @cluesurf/base/code/network/tcp
  find connection

task read
  mark async
  take connection, like connection
  take size, like size, need false
  like text

task write
  mark async
  take connection, like connection
  take data, like text
  like size

task close
  mark async
  take connection, like connection

task stream
  mark async
  take connection, like connection
  like list
