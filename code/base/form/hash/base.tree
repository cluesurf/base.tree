
form hash
  head k
  head v

  task get
    take self
    take key, like k

  task set
    take self, flex true
    take key, like k
    take value, like v

  task has
    take self
    take key, like k
    like boolean

  task remove
    take self, flex true
    take key, like k
    like boolean

  task keys
    take self

  task values
    take self

  task get-size
    take self
    like u64

  task is-empty
    take self
    like boolean

  task clear
    take self, flex true
