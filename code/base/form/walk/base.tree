
form walk
  head t

  task get-next
    take self, flex true

  task get-size
    take self
    like u64

  task map
    head s
    take self
    like walk

  task filter
    take self
    like walk

  task collect
    take self
    like list

  task reduce
    take self

  task zip
    take self
    take other, like walk

  task flatten
    take self
    like walk

  task get-first
    take self

  task partition
    take self

  task test-all
    take self
    like boolean

  task test-any
    take self
    like boolean
