
mint test
  case name
    slot name
  case zone, mint zone
    slot zone
  hook make
    make test
      bind name, read name
      bind zone, read zone

mint zone
  case call, mint call
    slot call
  case find, mint find
    slot find

mint find
  case name
    slot name
  case bind, mint bind
    slot bind
  case flow, mint flow
    slot flow
  case hook, mint hook
    slot hook
  hook make
    make find
      bind name, read name
      bind bind, read bind
      bind flow, read flow
      bind hook, read hook
