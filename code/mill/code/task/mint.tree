
load @cluesurf/base/code/task
  find task
  find head

mint task, like task
  case name
    slot name
  case head, mint head
    slot head
  case base, mint base
    slot base
  case flow, mint flow
    slot flow
  case task, mint task
    slot task
  hook make
    make task
      bind name, read name
      bind head, read head
      bind base, read base
      bind flow, read flow
      bind task, read task

mint head, like head
  case name
    slot name
  case form, mint form
    slot form
  case fall
    slot fall
  hook make
    make head
      bind name, read name
      bind head-form, read form
      bind fall, read fall

mint base
  case name
    slot name
  case form, mint form
    slot form
  case fall
    slot fall
  hook make
    make base
      bind name, read name
      bind link-form, read form
      bind fall, read fall

mint flow
  case call, mint call
    slot call
  case make, mint make
    slot make
  case save, mint save
    slot save
  case turn, mint turn
    slot turn
  case rein
    slot rein
  case show, mint show
    slot show
  case halt, mint halt
    slot halt

mint show
  case sift, mint sift
    slot sift
  hook make
    make show
      bind sift, read sift

mint halt
  case term
    slot term
  hook make
    make halt
      bind term, read term

mint save
  case name
    slot name
  case sift, mint sift
    slot sift
  hook make
    make save
      bind name, read name
      bind sift, read sift

mint turn
  case name
    slot name
  case sift, mint sift
    slot sift
  case line
    slot line
  hook make
    make turn
      bind name, read name
      bind sift, read sift
      bind line, read line
