note <Keyed-hash message authentication (HMAC). The clean uniform interface; the per-env native implementation is selected at build time and hidden. The interface is async to stay uniform with the rest of cryptography (some platforms only expose crypto asynchronously).>

load @cluesurf/base/code/native/cryptography/hmac
  find hmac-sha256
  find hmac-sha512

# the HMAC algorithm selector
form hmac-algorithm
  case sha-256
  case sha-512

# authenticate data under a key with the chosen algorithm. The named sha256 / sha512 forms below are the readable
# default; this verb is for an algorithm chosen at runtime. A constant algorithm specializes to the one native call.
task hmac
  mark async
  take key, like text
  take data, like text
  take algorithm, like hmac-algorithm
  like text
  fork case, read algorithm
    case sha-256
      send back
        call hmac-sha256
          read key
          read data
          wait true
    case sha-512
      send back
        call hmac-sha512
          read key
          read data
          wait true

# named algorithm forms: the readable, primary surface, each calling the native HMAC directly
task sha256
  mark async
  take key, like text
  take data, like text
  like text
  send back
    call hmac-sha256
      read key
      read data
      wait true

task sha512
  mark async
  take key, like text
  take data, like text
  like text
  send back
    call hmac-sha512
      read key
      read data
      wait true
