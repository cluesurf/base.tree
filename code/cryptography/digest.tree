note <Cryptographic digests (one-way hashes). The clean uniform interface; the per-env native implementation is selected at build time and hidden. The interface is async because some platforms (the browser Web Crypto API) only expose crypto asynchronously, and the interface stays uniform across every target.>

load @cluesurf/base/code/native/cryptography/digest
  find digest-sha256
  find digest-sha512
  find digest-md5

# the digest algorithm selector
form digest-algorithm
  case sha-256
  case sha-512
  case md5

# compute a one-way hash of the input with the chosen algorithm. The named sha256 / sha512 / md5 forms below are the
# readable default; this verb is for an algorithm chosen at runtime. A constant algorithm specializes to the one native
# digest, so both spellings emit the same call.
task digest
  mark async
  take input, like text
  take algorithm, like digest-algorithm
  like text
  fork case, read algorithm
    case sha-256
      send back
        call digest-sha256
          read input
          wait true
    case sha-512
      send back
        call digest-sha512
          read input
          wait true
    case md5
      send back
        call digest-md5
          read input
          wait true

# named algorithm forms: the readable, primary surface, each calling the native digest directly
task sha256
  mark async
  take input, like text
  like text
  send back
    call digest-sha256
      read input
      wait true

task sha512
  mark async
  take input, like text
  like text
  send back
    call digest-sha512
      read input
      wait true

task md5
  mark async
  take input, like text
  like text
  send back
    call digest-md5
      read input
      wait true
