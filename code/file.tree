
task read
  mark async
  take path, like text
  take format, like text, fall text <text>
  like text

task write
  mark async
  take path, like text
  take data, like text

task append
  mark async
  take path, like text
  take data, like text

task copy
  mark async
  take from, like text
  take to, like text
  take deep, like bool, fall false

task move
  mark async
  take from, like text
  take to, like text

task remove
  mark async
  take path, like text
  take deep, like bool, fall false

task test
  mark async
  take path, like text
  take kind, like text, need false
  like bool

task watch
  mark async
  take path, like text
  take deep, like bool, fall wave false
