
load @cluesurf/base/code/network/tcp
  find connection

task read
  wait true
  take connection, like connection
  take size, like size, need false

  save raw, read connection/dock

  save result
    call make-promise
      task resolve
        take ok
        take fail
        call raw/once
          text <data>
          task on-data
            take chunk
            call ok, read chunk
        call raw/once
          text <error>
          task on-error
            take error
            call fail, read error
        call raw/once
          text <end>
          task on-end
            call ok, wave false
      wait true
      halt kink

  send back, read result

task write
  wait true
  take connection, like connection
  take data, like text

  save raw, read connection/dock

  save result
    call make-promise
      task resolve
        take ok
        take fail
        call raw/write
          read data
          task on-write
            take error
            fork test
              hook test
                call is-some, read error
              hook hold
                call fail, read error
              hook miss
                call ok
      wait true
      halt kink

  send back, read result

task close
  wait true
  take connection, like connection

  save raw, read connection/dock

  call make-promise
    task resolve
      take ok
      call raw/end
        task on-end
          call ok
    wait true

task stream
  wait true
  take connection, like connection

  save raw, read connection/dock
  send back, read raw
