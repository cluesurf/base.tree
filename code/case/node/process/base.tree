
dock load
  load <node:child_process>, name cp

load @cluesurf/base/code/process
  find result
  find child

task run
  wait true
  take command, like text
  take arguments, like list, need false
  take directory, like text, need false
  take environment, like hash, need false
  take shell, like bool, fall false
  take timeout, like size, need false
  take input, like text, need false
  like result

  save options, make object
    bind encoding, text <utf8>

  fork test, read shell
    hook true
      call options/set
        text <shell>
        wave true

  fork test
    call is-some, bind value, read directory
    hook true
      call options/set
        text <cwd>
        read directory

  fork test
    call is-some, bind value, read environment
    hook true
      call options/set
        text <env>
        read environment

  fork test
    call is-some, bind value, read timeout
    hook true
      call options/set
        text <timeout>
        read timeout

  fork test
    call is-some, bind value, read input
    hook true
      call options/set
        text <input>
        read input

  save output
    call promise/make
      wait true
      take resolve, like task
      take reject, like task
      call cp/exec-file
        read command
        read arguments
        read options
        take error
        take stdout
        take stderr
        fork test
          call is-some, bind value, read error
          hook true
            call resolve
              make result
                bind code
                  fork test
                    call is-some, bind value, read error/code
                    hook true
                      send back, read error/code
                    hook false
                      send back, mark 1
                bind stdout
                  fork test
                    call is-some, bind value, read stdout
                    hook true
                      send back, read stdout
                    hook false
                      send back, text <>
                bind stderr
                  fork test
                    call is-some, bind value, read stderr
                    hook true
                      send back, read stderr
                    hook false
                      send back, text <>
                bind ok, wave false
          hook false
            call resolve
              make result
                bind code, mark 0
                bind stdout, read stdout
                bind stderr, read stderr
                bind ok, wave true

  send back, read output

task spawn
  wait true
  take command, like text
  take arguments, like list, need false
  take directory, like text, need false
  take environment, like hash, need false
  take shell, like bool, fall false
  like child

  save options, make object
    bind stdio, make list
      text <pipe>
      text <pipe>
      text <pipe>

  fork test, read shell
    hook true
      call options/set
        text <shell>
        wave true

  fork test
    call is-some, bind value, read directory
    hook true
      call options/set
        text <cwd>
        read directory

  fork test
    call is-some, bind value, read environment
    hook true
      call options/set
        text <env>
        read environment

  save handle
    call cp/spawn
      read command
      read arguments
      read options

  send back
    make child
      bind dock, read handle
      bind id, read handle/pid
