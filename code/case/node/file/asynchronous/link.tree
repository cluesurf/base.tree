
dock load
  load <node:fs/promises>, name fs-promise

task make
  wait true
  take from, like text
  take to, like text
  take hard, like bool, fall wave false

  fork test, name hard
    hook true
      call fs-promise/link
        wait true
        read from
        read to
        halt kink
    hook false
      call fs-promise/symlink
        wait true
        read from
        read to
        halt kink

task read
  wait true
  take path, like text

  send back
    call fs-promise/readlink
      wait true
      read path
      halt kink
