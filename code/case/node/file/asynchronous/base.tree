
dock load
  load <node:fs/promises>, name fs-promise
  load <node:fs>, name fs

task read
  wait true
  take path, like text
  take format, like text, fall text <text>

  fork test, call is-equal, read format, text <bytes>
    hook true
      save result
        call fs-promise/read-file
          wait true
          read path
          halt kink
      send back, read result
    hook false
      save result
        call fs-promise/read-file
          wait true
          read path
          text <utf8>
          halt kink
      send back, read result

task write
  wait true
  take path, like text
  take data, like text

  call fs-promise/write-file
    wait true
    read path
    read data
    halt kink

task append
  wait true
  take path, like text
  take data, like text

  call fs-promise/append-file
    wait true
    read path
    read data
    halt kink

task copy
  wait true
  take from, like text
  take to, like text
  take deep, like bool, fall wave false

  fork test, name deep
    hook true
      call fs-promise/cp
        wait true
        read from
        read to
        make options
          bind recursive, wave true
        halt kink
    hook false
      call fs-promise/copy-file
        wait true
        read from
        read to
        halt kink

task move
  wait true
  take from, like text
  take to, like text

  call fs-promise/rename
    wait true
    read from
    read to
    halt kink

task remove
  wait true
  take path, like text
  take deep, like bool, fall wave false

  call fs-promise/rm
    wait true
    read path
    make options
      bind recursive, read deep
      bind force, wave true
    halt kink

task test
  wait true
  take path, like text
  take kind, like text, need false

  call fs-promise/access
    wait true
    read path
    halt kink

  fork test, call is-null, read kind
    hook true
      send back, wave true

  save stats
    call fs-promise/stat
      wait true
      read path
      halt kink

  fork test, call is-equal, read kind, text <file>
    hook true
      send back
        call stats/is-file

  fork test, call is-equal, read kind, text <directory>
    hook true
      send back
        call stats/is-directory

  fork test, call is-equal, read kind, text <link>
    hook true
      send back
        call stats/is-symbolic-link

  send back, wave true

task watch
  wait true
  take path, like text
  take deep, like bool, fall wave false

  call fs/watch
    read path
    make options
      bind recursive, read deep
