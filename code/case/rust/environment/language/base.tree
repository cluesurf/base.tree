
task read
  save tag
    call sys-locale-get-locale
  save parts
    call split
      read tag
      text <->
  save language, read parts/0
  save region
    fork test, call is-above, read parts/length, mark 1
      hook true
        read parts/1
      hook false
        text <>
  send back
    make locale
      bind language, read language
      bind region, read region
      bind tag, read tag
      bind timezone, text <>

task list
  save tag
    call sys-locale-get-locale
  send back
    make list
      read tag

task sys-locale-get-locale
  hide true
  dock call <sys_locale::get_locale().unwrap_or_else(|| String::from("en-US"))>
