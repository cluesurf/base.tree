
load @cluesurf/base/code/network/websocket
  find socket

load @cluesurf/base/code/network/websocket/socket
  find message

task send
  wait true
  take socket, like socket
  take data, like text

  save raw, read socket/dock
  call raw/send, read data

task close
  wait true
  take socket, like socket
  take code, like size, fall 1000
  take reason, like text, need false

  save raw, read socket/dock
  call raw/close, read code, read reason

  call make-promise
    task resolve
      take ok
      save on-close
        task handle-close
          call ok
      save raw/onclose, read on-close
    wait true

task stream
  wait true
  take socket, like socket

  save raw, read socket/dock
  send back, read raw
