
form maybe
  head t
  case some
    link value, like t
  case none

  task is-some
    take self
    like boolean
    fork case, read self
      case some
        send back, wave true
      case none
        send back, wave false

  task is-none
    take self
    like boolean
    fork case, read self
      case some
        send back, wave false
      case none
        send back, wave true

  task unwrap-or
    take self
    take fallback, like t
    like t
    fork case, read self
      case some
        send back, read self/value
      case none
        send back, read fallback

  task map
    head s
    take self
    take call
      like task
        take value, like t
        like s
    like maybe
    fork case, read self
      case some
        send back
          make some
            bind value
              call call
                read self/value
      case none
        send back
          make none
