note <HSL color (hue 0-360, saturation 0-100, lightness 0-100) and conversion from RGB. Integer-scaled, pure logic on top of the math interface.>

load @cluesurf/base/code/color/rgb
  find rgb-color

load @cluesurf/base/code/math
  find minimum
  find maximum
  find absolute

form hsl-color
  link hue, like number
  link saturation, like number
  link lightness, like number

task from-rgb
  take color, like rgb-color
  like hsl-color
  save high
    call maximum
      call maximum
        read color/red
        read color/green
      read color/blue
  save low
    call minimum
      call minimum
        read color/red
        read color/green
      read color/blue
  save total
    call add
      read high
      read low
  save lightness
    call divide
      call multiply
        read total
        mark 100
      mark 510
  save delta
    call subtract
      read high
      read low
  save hue, mark 0
  save saturation, mark 0
  fork test
    hook test
      call is-above
        read delta
        mark 0
    hook hold
      save denominator, read total
      fork test
        hook test
          call is-above
            read total
            mark 255
        hook hold
          save denominator
            call subtract
              mark 510
              read total
      save saturation
        call divide
          call multiply
            read delta
            mark 100
          read denominator
      fork test
        hook test
          call is-equal
            read high
            read color/red
        hook hold
          save hue
            call divide
              call multiply
                call subtract
                  read color/green
                  read color/blue
                mark 60
              read delta
        hook test
          call is-equal
            read high
            read color/green
        hook hold
          save hue
            call divide
              call multiply
                call add
                  call multiply
                    read delta
                    mark 2
                  call subtract
                    read color/blue
                    read color/red
                mark 60
              read delta
        hook miss
          save hue
            call divide
              call multiply
                call add
                  call multiply
                    read delta
                    mark 4
                  call subtract
                    read color/red
                    read color/green
                mark 60
              read delta
      fork test
        hook test
          call is-below
            read hue
            mark 0
        hook hold
          save hue
            call add
              read hue
              mark 360
  send back
    make hsl-color
      bind hue, read hue
      bind saturation, read saturation
      bind lightness, read lightness

task to-rgb
  take color, like hsl-color
  like rgb-color
  save one-minus
    call subtract
      mark 100
      call absolute
        call subtract
          call multiply
            read color/lightness
            mark 2
          mark 100
  save chroma
    call divide
      call multiply
        call multiply
          read one-minus
          read color/saturation
        mark 255
      mark 10000
  save hue-prime
    call divide
      call multiply
        read color/hue
        mark 100
      mark 60
  save hue-mod
    call modulo
      read hue-prime
      mark 200
  save x-factor
    call subtract
      mark 100
      call absolute
        call subtract
          read hue-mod
          mark 100
  save second
    call divide
      call multiply
        read chroma
        read x-factor
      mark 100
  save match
    call subtract
      call divide
        call multiply
          read color/lightness
          mark 255
        mark 100
      call divide
        read chroma
        mark 2
  save sector
    call divide
      read color/hue
      mark 60
  save red-base, mark 0
  save green-base, mark 0
  save blue-base, mark 0
  fork test
    hook test
      call is-equal
        read sector
        mark 0
    hook hold
      save red-base, read chroma
      save green-base, read second
    hook test
      call is-equal
        read sector
        mark 1
    hook hold
      save red-base, read second
      save green-base, read chroma
    hook test
      call is-equal
        read sector
        mark 2
    hook hold
      save green-base, read chroma
      save blue-base, read second
    hook test
      call is-equal
        read sector
        mark 3
    hook hold
      save green-base, read second
      save blue-base, read chroma
    hook test
      call is-equal
        read sector
        mark 4
    hook hold
      save red-base, read second
      save blue-base, read chroma
    hook miss
      save red-base, read chroma
      save blue-base, read second
  send back
    make rgb-color
      bind red
        call add
          read red-base
          read match
      bind green
        call add
          read green-base
          read match
      bind blue
        call add
          read blue-base
          read match
