
dock load
  load <node:fs/promises>, name fs-promise
  load <node:fs>, name fs
  load <node:path>, name path
  load <node:os>, name os

task make-temp-dir
  wait true

  send back
    call fs-promise/mkdtemp
      wait true
      call path/join
        call os/tmpdir
        text <seed-test->
      halt kink

task run-tests
  wait true

  save dir
    call make-temp-dir
      wait true

  save source
    call path/join
      read dir
      text <source.txt>

  call fs-promise/write-file
    wait true
    read source
    text <link content>
    halt kink

  note <Test symlink>
  save sym
    call path/join
      read dir
      text <sym.txt>

  call fs-promise/symlink
    wait true
    read source
    read sym
    halt kink

  save sym-content
    call fs-promise/read-file
      wait true
      read sym
      text <utf8>
      halt kink

  fork test, call is-equal, read sym-content, text <link content>
    hook true
      call console/log
        text <pass: symlink-read>
    hook false
      call console/log
        text <fail: symlink-read>

  note <Test readlink>
  save target
    call fs-promise/readlink
      wait true
      read sym
      halt kink

  fork test, call is-equal, read target, read source
    hook true
      call console/log
        text <pass: readlink>
    hook false
      call console/log
        text <fail: readlink>

  note <Test hard link>
  save hard
    call path/join
      read dir
      text <hard.txt>

  call fs-promise/link
    wait true
    read source
    read hard
    halt kink

  save hard-content
    call fs-promise/read-file
      wait true
      read hard
      text <utf8>
      halt kink

  fork test, call is-equal, read hard-content, text <link content>
    hook true
      call console/log
        text <pass: hard-link-read>
    hook false
      call console/log
        text <fail: hard-link-read>

  note <Cleanup>
  call fs-promise/rm
    wait true
    read dir
    make options
      bind recursive, wave true
      bind force, wave true
    halt kink

  call console/log
    text <done>
